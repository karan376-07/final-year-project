# Copy to .env and fill in the blanks:   cp .env.example .env
#
# NEVER commit .env -- it holds real API keys. It is in .gitignore.
# Generate a JWT secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# GEMINI_API_KEYS takes several keys, comma separated, so the app can rotate
# past a per-minute rate limit. Gemini quota is per Google Cloud PROJECT, not
# per key, so extra keys only help if they belong to different projects.

ENVIRONMENT=development
DEMO_MODE=False
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_TIMEOUT_SECONDS=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
MAX_SYNC_EMAILS=50
IMAP_MAX_EMAILS=50
GEMINI_API_KEYS=
